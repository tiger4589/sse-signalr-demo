@page "/"
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>SSE Demo</PageTitle>

<div class="page-shell">
    <h1>SSE demo: same client against .NET 9 and .NET 10</h1>

    <div class="panel-grid">
        @foreach (var endpoint in endpoints)
        {
            <div class="endpoint-panel">
                <h2>@endpoint.Name</h2>
                <p class="endpoint-url">@endpoint.Url</p>

                <div class="status-row">
                    <span class="status-label">Status:</span>
                    <span class="status-value @(endpoint.IsConnected ? "connected" : "stopped")">@endpoint.StatusText</span>
                </div>

                <div class="counter-box">
                    <span class="counter-label">Latest value</span>
                    <strong>@endpoint.LastValue</strong>
                </div>

                <div class="button-row">
                    <button class="primary" @onclick="() => StartEndpoint(endpoint.Id)" disabled="@endpoint.IsConnected">
                        Start
                    </button>
                    <button class="secondary" @onclick="() => StopEndpoint(endpoint.Id)" disabled="@(!endpoint.IsConnected)">
                        Stop
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(endpoint.Error))
                {
                    <p class="error-message">@endpoint.Error</p>
                }
            </div>
        }
    </div>
</div>

<style>
    .page-shell {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem;
        font-family: sans-serif;
    }

    h1 {
        margin-bottom: 1.5rem;
    }

    .panel-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 1.5rem;
    }

    .endpoint-panel {
        background: #f8fafc;
        border: 1px solid #dbe4ee;
        border-radius: 12px;
        padding: 1.25rem;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.06);
    }

    .endpoint-panel h2 {
        margin-top: 0;
        margin-bottom: 0.75rem;
    }

    .endpoint-url {
        margin: 0 0 1rem;
        color: #475569;
        font-size: 0.95rem;
        word-break: break-all;
    }

    .status-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
    }

    .status-label {
        color: #334155;
        font-weight: 600;
    }

    .status-value {
        font-weight: 700;
    }

    .status-value.connected {
        color: #15803d;
    }

    .status-value.stopped {
        color: #475569;
    }

    .counter-box {
        background: #ffffff;
        border: 1px solid #dfe6ee;
        border-radius: 10px;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        margin-bottom: 1rem;
    }

    .counter-label {
        font-size: 0.8rem;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .counter-box strong {
        font-size: 2rem;
        color: #0f172a;
    }

    .button-row {
        display: flex;
        gap: 0.75rem;
    }

    button {
        border: none;
        border-radius: 8px;
        padding: 0.7rem 1rem;
        font-size: 0.96rem;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.2s ease;
    }

    button:disabled {
        opacity: 0.55;
        cursor: not-allowed;
    }

    .primary {
        background: #2563eb;
        color: white;
    }

    .secondary {
        background: #e2e8f0;
        color: #0f172a;
    }

    .error-message {
        margin-top: 1rem;
        color: #b91c1c;
        font-weight: 600;
    }
</style>

@code {
    private sealed class SseEndpointModel
    {
        public string Id { get; init; } = string.Empty;
        public string Name { get; init; } = string.Empty;
        public string Url { get; init; } = string.Empty;
        public int LastValue { get; set; }
        public bool IsConnected { get; set; }
        public string StatusText => IsConnected ? "Connected" : "Stopped";
        public string Error { get; set; } = string.Empty;
    }

    private readonly List<SseEndpointModel> endpoints =
    [
        new() { Id = "dotnet9", Name = "DotNet9Api", Url = "https://localhost:9001/events" },
        new() { Id = "dotnet10", Name = "DotNet10Api", Url = "https://localhost:9002/events" }
    ];

    private IJSObjectReference? sseModule;
    private readonly Dictionary<string, DotNetObjectReference<Home>> referenceCache = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            sseModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/sseClient.js");
        }
    }

    private async Task StartEndpoint(string id)
    {
        if (sseModule is null)
        {
            return;
        }

        var endpoint = endpoints.First(x => x.Id == id);
        if (endpoint.IsConnected)
        {
            return;
        }

        endpoint.Error = string.Empty;

        var objRef = DotNetObjectReference.Create(this);
        referenceCache[id] = objRef;

        try
        {
            await sseModule.InvokeVoidAsync("connect", id, endpoint.Url, objRef, "HandleMessage", "HandleError");
            endpoint.IsConnected = true;
        }
        catch
        {
            endpoint.IsConnected = false;

            if (referenceCache.TryGetValue(id, out var reference))
            {
                reference.Dispose();
                referenceCache.Remove(id);
            }
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task StopEndpoint(string id)
    {
        if (sseModule is null)
        {
            return;
        }

        var endpoint = endpoints.First(x => x.Id == id);

        await sseModule.InvokeVoidAsync("disconnect", id);

        endpoint.IsConnected = false;
        endpoint.Error = string.Empty;

        if (referenceCache.TryGetValue(id, out var reference))
        {
            reference.Dispose();
            referenceCache.Remove(id);
        }

        StateHasChanged();
    }

    [JSInvokable]
    public void HandleMessage(string id, string data)
    {
        var endpoint = endpoints.FirstOrDefault(x => x.Id == id);
        if (endpoint is null)
        {
            return;
        }

        if (int.TryParse(data, out var value))
        {
            endpoint.LastValue = value;
        }

        endpoint.IsConnected = true;
        endpoint.Error = string.Empty;
        StateHasChanged();
    }

    [JSInvokable]
    public void HandleError(string id, string message)
    {
        var endpoint = endpoints.FirstOrDefault(x => x.Id == id);
        if (endpoint is null)
        {
            return;
        }

        endpoint.IsConnected = false;
        endpoint.Error = message;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (sseModule is not null)
        {
            foreach (var endpoint in endpoints)
            {
                await sseModule.InvokeVoidAsync("disconnect", endpoint.Id);
            }
        }

        foreach (var reference in referenceCache.Values)
        {
            reference.Dispose();
        }
    }
}
