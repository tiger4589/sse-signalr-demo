@page "/"
@implements IAsyncDisposable
@using DemoShared
@using Microsoft.AspNetCore.SignalR.Client
@using System.Text.Json
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>SignalR vs SSE Demo</PageTitle>

<div class="page-shell">
    <h1>SignalR vs SSE Conference Demo</h1>

    <div class="toolbar">
        <button class="primary" @onclick="ConnectBothAsync">Connect both</button>
        <button class="secondary" @onclick="ClearLogs">Clear logs</button>
    </div>

    <div class="scenario-row">
        @foreach (var scenario in ScenarioButtons)
        {
            <button @onclick="() => TriggerScenarioAsync(scenario.Key)">@scenario.Value</button>
        }
    </div>

    <div class="panel-grid">
        <div class="demo-panel signalr-panel">
            <h2>SignalR Demo</h2>
            <div class="meta-row"><strong>User:</strong> @SignalRUserSummary</div>
            <div class="meta-row"><strong>Connection:</strong> @_signalrConnectionId</div>
            <div class="meta-row"><strong>Status:</strong> <span class="status @(_signalrStatus == "Connected" ? "connected" : "offline")">@_signalrStatus</span></div>

            <div class="group-box">
                <h3>Warehouses</h3>
                @foreach (var warehouse in DemoWarehouseCatalog.Warehouses)
                {
                    <label class="check-item">
                        <input type="checkbox" checked="@_signalrWarehouses.Contains(warehouse)" @onchange="() => ToggleSignalRWarehouseAsync(warehouse)" />
                        <span>@warehouse</span>
                    </label>
                }
            </div>

            <div class="group-box">
                <h3>Event Types</h3>
                @foreach (var eventType in Enum.GetNames<DemoEventType>())
                {
                    var friendlyName = ToFriendlyEventName(eventType);
                    <label class="check-item">
                        <input type="checkbox" checked="@_signalrEventTypes.Contains(friendlyName)" @onchange="() => ToggleSignalREventTypeAsync(friendlyName)" />
                        <span>@friendlyName</span>
                    </label>
                }
            </div>

            <div class="log">
                @foreach (var demoEvent in _signalrEvents)
                {
                    <div class="event-item @(demoEvent.UserId == SignalRUserId ? "relevant" : "normal")">
                        <div class="event-time">@demoEvent.Timestamp.ToLocalTime().ToString("HH:mm:ss")</div>
                        <div class="event-name">@demoEvent.Type</div>
                        <div class="event-meta">Warehouse: @(demoEvent.Warehouse ?? "—")</div>
                        <div class="event-meta">Target: @(demoEvent.TargetLabel)</div>
                        <div class="event-message">@demoEvent.Message</div>
                    </div>
                }
            </div>
        </div>

        <div class="demo-panel sse-panel">
            <h2>SSE Demo</h2>
            <div class="meta-row"><strong>User:</strong> @SseUserSummary</div>
            <div class="meta-row"><strong>Connection:</strong> @_sseConnectionId</div>
            <div class="meta-row"><strong>Status:</strong> <span class="status @(_sseStatus == "Connected" ? "connected" : "offline")">@_sseStatus</span></div>

            <div class="group-box">
                <h3>Warehouses</h3>
                @foreach (var warehouse in DemoWarehouseCatalog.Warehouses)
                {
                    <label class="check-item">
                        <input type="checkbox" checked="@_sseWarehouses.Contains(warehouse)" @onchange="() => ToggleSseWarehouseAsync(warehouse)" />
                        <span>@warehouse</span>
                    </label>
                }
            </div>

            <div class="group-box">
                <h3>Event Types</h3>
                @foreach (var eventType in Enum.GetNames<DemoEventType>())
                {
                    var friendlyName = ToFriendlyEventName(eventType);
                    <label class="check-item">
                        <input type="checkbox" checked="@_sseEventTypes.Contains(friendlyName)" @onchange="() => ToggleSseEventTypeAsync(friendlyName)" />
                        <span>@friendlyName</span>
                    </label>
                }
            </div>

            <div class="log">
                @foreach (var demoEvent in _sseEvents)
                {
                    <div class="event-item @(demoEvent.UserId == SseUserId ? "relevant" : "normal")">
                        <div class="event-time">@demoEvent.Timestamp.ToLocalTime().ToString("HH:mm:ss")</div>
                        <div class="event-name">@demoEvent.Type</div>
                        <div class="event-meta">Warehouse: @(demoEvent.Warehouse ?? "—")</div>
                        <div class="event-meta">Target: @(demoEvent.TargetLabel)</div>
                        <div class="event-message">@demoEvent.Message</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    body {
        margin: 0;
        font-family: 'Segoe UI', sans-serif;
        background: #0f172a;
        color: #e2e8f0;
    }

    .page-shell {
        max-width: 1400px;
        margin: 0 auto;
        padding: 2rem;
    }

    h1 {
        margin-bottom: 1.5rem;
    }

    .toolbar {
        display: flex;
        gap: 1rem;
        align-items: center;
        margin-bottom: 1rem;
        flex-wrap: wrap;
    }

    button {
        border-radius: 8px;
        border: 1px solid #475569;
        padding: 0.7rem 1rem;
        font-size: 0.95rem;
    }

    .primary {
        background: #3b82f6;
        color: white;
    }

    .secondary {
        background: #334155;
        color: #f8fafc;
    }

    .scenario-row {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
    }

    .panel-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    .demo-panel {
        background: rgba(15, 23, 42, 0.8);
        border: 1px solid #475569;
        border-radius: 14px;
        padding: 1.25rem;
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.25);
    }

    .meta-row {
        margin-bottom: 0.5rem;
    }

    .status {
        font-weight: 700;
    }

    .status.connected {
        color: #4ade80;
    }

    .status.offline {
        color: #fca5a5;
    }

    .group-box {
        margin-top: 1rem;
        padding-top: 0.8rem;
        border-top: 1px solid #334155;
    }

    .check-item {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        margin: 0.35rem 0;
    }

    .log {
        margin-top: 1.2rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        max-height: 500px;
        overflow-y: auto;
    }

    .event-item {
        background: rgba(30, 41, 59, 0.9);
        border-left: 4px solid #60a5fa;
        border-radius: 8px;
        padding: 0.75rem;
    }

    .event-item.relevant {
        border-left-color: #22c55e;
    }

    .event-item.normal {
        border-left-color: #fbbf24;
    }

    .event-time {
        font-weight: 700;
        color: #93c5fd;
    }

    .event-name {
        font-size: 1.05rem;
        font-weight: 700;
        margin: 0.2rem 0;
    }

    .event-meta {
        color: #cbd5e1;
    }

    .event-message {
        margin-top: 0.5rem;
        color: #f8fafc;
    }

    @@media (max-width: 980px) {
        .panel-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private const string SignalRUrl = "https://localhost:9004";
    private const string SseUrl = "https://localhost:9003";
    private const string ProducerUrl = "https://localhost:9005";
    private const string SignalRUserId = "Alice";
    private const string SseUserId = "Bob";
    private const string SseClientId = "thirdpart-sse";

    private readonly Dictionary<string, string> ScenarioButtons = new()
    {
        ["NormalOperations"] = "Normal Operations",
        ["BrusselsIncident"] = "Brussels Incident",
        ["PaymentIncident"] = "Payment Incident",
        ["UserNotification"] = "Notify Alice",
        ["AlertFinance"] = "Alert Finance",
        ["BroadcastEmergency"] = "Broadcast Emergency",
        ["Random"] = "Generate Random Event"
    };

    private readonly HashSet<string> _signalrWarehouses = new(StringComparer.OrdinalIgnoreCase) { "Brussels" };
    private readonly HashSet<string> _signalrEventTypes = new(StringComparer.OrdinalIgnoreCase) { "Orders", "Shipments", "System Alerts" };
    private readonly HashSet<string> _sseWarehouses = new(StringComparer.OrdinalIgnoreCase) { "Antwerp" };
    private readonly HashSet<string> _sseEventTypes = new(StringComparer.OrdinalIgnoreCase) { "Orders", "Shipments", "System Alerts" };

    private HubConnection? _signalrConnection;
    private IJSObjectReference? _sseModule;
    private DotNetObjectReference<Home>? _sseDotNetReference;
    private string _signalrStatus = "Disconnected";
    private string _signalrConnectionId = "n/a";
    private readonly List<DemoEvent> _signalrEvents = new();
    private readonly List<DemoEvent> _sseEvents = new();
    private string _sseStatus = "Disconnected";
    private string _sseConnectionId = "n/a";
    private static readonly JsonSerializerOptions JsonOptions = new() { PropertyNameCaseInsensitive = true };
    private static string BuildUserSummary(string userId)
    {
        var user = DemoUserCatalog.Get(userId);
        return user is null
            ? userId
            : $"{user.Name} ({user.Role}, {user.Warehouse})";
    }

    private static string SignalRUserSummary => BuildUserSummary(SignalRUserId);
    private static string SseUserSummary => BuildUserSummary(SseUserId);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _sseModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/sseClient.js");
    }

    private async Task ConnectBothAsync()
    {
        await ConnectSignalRAsync();
        await ConnectSseAsync();
    }

    private async Task ConnectSignalRAsync()
    {
        if (_signalrConnection is not null)
        {
            return;
        }

        _signalrConnection = new HubConnectionBuilder()
            .WithUrl($"{SignalRUrl}/demohub?userId={SignalRUserId}")
            .WithAutomaticReconnect()
            .Build();

        _signalrConnection.On<DemoEvent>("ReceiveEvent", demoEvent =>
        {
            _signalrEvents.Insert(0, demoEvent);
            if (_signalrEvents.Count > 25)
            {
                _signalrEvents.RemoveAt(_signalrEvents.Count - 1);
            }

            InvokeAsync(StateHasChanged);
        });

        await _signalrConnection.StartAsync();
        _signalrConnectionId = _signalrConnection.ConnectionId ?? "n/a";
        _signalrStatus = "Connected";

        foreach (var warehouse in _signalrWarehouses)
        {
            await _signalrConnection.InvokeAsync("JoinWarehouse", warehouse);
        }

        foreach (var eventType in _signalrEventTypes)
        {
            await _signalrConnection.InvokeAsync("SubscribeToEventType", eventType);
        }
    }

    private async Task ConnectSseAsync()
    {
        if (_sseModule is null || _sseConnectionId != "n/a")
        {
            return;
        }

        var connectionId = Guid.NewGuid().ToString();
        var sseUrl = $"{SseUrl}/events?userId={Uri.EscapeDataString(SseUserId)}&connectionId={Uri.EscapeDataString(connectionId)}";

        try
        {
            _sseDotNetReference?.Dispose();
            _sseDotNetReference = DotNetObjectReference.Create(this);
            await _sseModule.InvokeVoidAsync("connect", SseClientId, sseUrl, _sseDotNetReference, "HandleSseMessage", "HandleSseError");
            _sseConnectionId = connectionId;
            await ApplySseSubscriptionsAsync();
            _sseStatus = "Connected";
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            if (_sseModule is not null)
            {
                await _sseModule.InvokeVoidAsync("disconnect", SseClientId);
            }

            _sseStatus = "Disconnected";
            _sseConnectionId = "n/a";
            _sseDotNetReference?.Dispose();
            _sseDotNetReference = null;
        }
    }

    [JSInvokable]
    public Task HandleSseMessage(string id, string data)
    {
        if (!string.Equals(id, SseClientId, StringComparison.Ordinal))
        {
            return Task.CompletedTask;
        }

        var demoEvent = JsonSerializer.Deserialize<DemoEvent>(data, JsonOptions);
        if (demoEvent is null)
        {
            return Task.CompletedTask;
        }

        _sseEvents.Insert(0, demoEvent);
        if (_sseEvents.Count > 25)
        {
            _sseEvents.RemoveAt(_sseEvents.Count - 1);
        }

        _sseStatus = "Connected";
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task HandleSseError(string id, string message)
    {
        if (!string.Equals(id, SseClientId, StringComparison.Ordinal))
        {
            return Task.CompletedTask;
        }

        _sseStatus = "Disconnected";
        _sseConnectionId = "n/a";
        _sseDotNetReference?.Dispose();
        _sseDotNetReference = null;
        return InvokeAsync(StateHasChanged);
    }

    private async Task ApplySseSubscriptionsAsync()
    {
        if (string.IsNullOrWhiteSpace(_sseConnectionId) || _sseConnectionId == "n/a")
        {
            return;
        }

        foreach (var warehouse in _sseWarehouses)
        {
            await UpdateSseSubscriptionAsync(warehouse, eventType: null, selected: true);
        }

        foreach (var eventType in _sseEventTypes)
        {
            await UpdateSseSubscriptionAsync(warehouse: null, eventType, selected: true);
        }
    }

    private async Task UpdateSseSubscriptionAsync(string? warehouse, string? eventType, bool selected)
    {
        if (string.IsNullOrWhiteSpace(_sseConnectionId) || _sseConnectionId == "n/a")
        {
            return;
        }

        var query = $"?userId={Uri.EscapeDataString(SseUserId)}&connectionId={Uri.EscapeDataString(_sseConnectionId)}";
        if (!string.IsNullOrWhiteSpace(warehouse))
        {
            query += $"&warehouse={Uri.EscapeDataString(warehouse)}";
        }

        if (!string.IsNullOrWhiteSpace(eventType))
        {
            query += $"&eventType={Uri.EscapeDataString(eventType)}";
        }

        using var response = await Http.SendAsync(new HttpRequestMessage(
            selected ? HttpMethod.Post : HttpMethod.Delete,
            $"{SseUrl}/events/subscriptions{query}"));

        response.EnsureSuccessStatusCode();
    }

    private async Task ToggleSignalRWarehouseAsync(string warehouse)
    {
        if (_signalrConnection is null)
        {
            return;
        }

        var isSelected = !_signalrWarehouses.Contains(warehouse);
        if (isSelected)
        {
            _signalrWarehouses.Add(warehouse);
            await _signalrConnection.InvokeAsync("JoinWarehouse", warehouse);
        }
        else
        {
            _signalrWarehouses.Remove(warehouse);
            await _signalrConnection.InvokeAsync("LeaveWarehouse", warehouse);
        }
    }

    private async Task ToggleSignalREventTypeAsync(string eventType)
    {
        if (_signalrConnection is null)
        {
            return;
        }

        var isSelected = !_signalrEventTypes.Contains(eventType);
        if (isSelected)
        {
            _signalrEventTypes.Add(eventType);
            await _signalrConnection.InvokeAsync("SubscribeToEventType", eventType);
        }
        else
        {
            _signalrEventTypes.Remove(eventType);
            await _signalrConnection.InvokeAsync("UnsubscribeFromEventType", eventType);
        }
    }

    private async Task ToggleSseWarehouseAsync(string warehouse)
    {
        if (string.IsNullOrWhiteSpace(_sseConnectionId) || _sseConnectionId == "n/a")
        {
            return;
        }

        var isSelected = !_sseWarehouses.Contains(warehouse);
        if (isSelected)
        {
            _sseWarehouses.Add(warehouse);
        }
        else
        {
            _sseWarehouses.Remove(warehouse);
        }

        await UpdateSseSubscriptionAsync(warehouse, eventType: null, isSelected);
    }

    private async Task ToggleSseEventTypeAsync(string eventType)
    {
        if (string.IsNullOrWhiteSpace(_sseConnectionId) || _sseConnectionId == "n/a")
        {
            return;
        }

        var isSelected = !_sseEventTypes.Contains(eventType);
        if (isSelected)
        {
            _sseEventTypes.Add(eventType);
        }
        else
        {
            _sseEventTypes.Remove(eventType);
        }

        await UpdateSseSubscriptionAsync(warehouse: null, eventType, isSelected);
    }

    private async Task TriggerScenarioAsync(string scenario)
    {
        using var response = await Http.PostAsync($"{ProducerUrl}/simulator/scenario/{scenario}", new StringContent(string.Empty));
        response.EnsureSuccessStatusCode();
    }

    private async Task ClearLogs()
    {
        _signalrEvents.Clear();
        _sseEvents.Clear();
        await Task.CompletedTask;
    }

    private static string ToFriendlyEventName(string name) => name switch
    {
        "OrderCreated" => "Orders",
        "ShipmentDelayed" => "Shipments",
        "PaymentReceived" => "Payments",
        "MaintenanceStarted" => "Maintenance",
        "SystemAlert" => "System Alerts",
        "UserNotification" => "User Notifications",
        _ => name
    };

    public async ValueTask DisposeAsync()
    {
        if (_sseModule is not null)
        {
            await _sseModule.InvokeVoidAsync("disconnect", SseClientId);
            await _sseModule.DisposeAsync();
        }

        _sseDotNetReference?.Dispose();

        if (_signalrConnection is not null)
        {
            await _signalrConnection.DisposeAsync();
        }
    }
}
